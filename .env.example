# DV Platform configuration (copy to .env). All vars are prefixed DVP_.
# See docs/design/01-architecture.md §5 for runtime modes.

# Runtime mode: local | server | prod
DVP_PROFILE=local

# Metadata store. In local mode this is ignored (in-memory SQLite is used).
# DVP_DATABASE_URL=postgresql+psycopg://dvp:dvp@localhost:5432/dvp

# Secret store backend: memory | keyring | file | vault
DVP_SECRET_BACKEND=memory

# Result store backend: local | object | snowflake
DVP_RESULT_BACKEND=local
DVP_RESULT_LOCAL_DIR=./.dvp/results

# Identity provider: local_nopassword | oidc
DVP_IDENTITY_PROVIDER=local_nopassword
# DVP_OIDC_ISSUER=
# DVP_OIDC_CLIENT_ID=

# API
DVP_API_HOST=127.0.0.1
DVP_API_PORT=8000
DVP_LOG_LEVEL=INFO
